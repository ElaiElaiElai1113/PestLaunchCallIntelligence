# Public Supabase values; obtain from the dedicated project.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
APP_ORIGIN=http://127.0.0.1:3000

# Server-only secrets; never expose through NEXT_PUBLIC or logs.
SUPABASE_SECRET_KEY=
AI_PROVIDER=gemini
GEMINI_API_KEY=
# Explicit demo transcription selection; no automatic fallback.
TRANSCRIPTION_PROVIDER=groq
# Groq key is needed for Whisper when TRANSCRIPTION_PROVIDER=groq.
GROQ_API_KEY=
# Set 0 for bounded demo verification; normal recovery permits at most 3 retries.
GROQ_WORKFLOW_RETRIES=0

# Verify and pin supported model IDs during feasibility checks.
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3
# Analysis is pinned to openai/gpt-oss-120b in the reference adapter; no fallback.

